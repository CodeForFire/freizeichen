<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>Freizeichen</AssemblyName>
    <RootNamespace>Freizeichen.App</RootNamespace>
    <Product>Freizeichen</Product>
    <AssemblyTitle>Freizeichen</AssemblyTitle>
    <Version>0.1.0</Version>
    <!-- LibraryImport marshals the CoreFoundation strings of the macOS tel: registration. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lagebuch's fonts (SIL OFL 1.1, see Assets/Fonts/README.md), referenced from Theme/Tokens.axaml. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- The windows' icon. The master is Assets/icon.svg; packaging/icon/build-icon-assets.sh renders the rest. -->
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licences travel with the installers: the OFL requires its text next to the fonts.
         Kept out of the single-file bundle so they sit beside the executable, readable. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Assets\Fonts\OFL.txt" Link="OFL.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- The icon the Linux desktop entries name: LinuxTelHandlerRegistration points at it beside the
         executable, and build-linux.sh renders the .deb's icon theme from it. -->
    <None Include="Assets\icon.svg" Link="freizeichen.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Freizeichen.AppLogic\Freizeichen.AppLogic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Freizeichen.App.Tests" />
  </ItemGroup>

</Project>
