<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Freizeichen.AppLogic.ViewModels;assembly=Freizeichen.AppLogic"
        x:Class="Freizeichen.App.Views.SettingsWindow"
        x:ClassModifier="internal"
        x:DataType="vm:SettingsViewModel"
        Title="Freizeichen"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock.status.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="24" Spacing="10">
    <TextBlock Text="Freizeichen" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Classes="hint" Text="Wählt tel:-Links über ein Gigaset DL500A per Bluetooth." />

    <TextBlock Classes="section" Text="Telefon" />
    <TextBlock Classes="hint" Text="Das Telefon per Bluetooth mit diesem PC koppeln – nicht als Audiogerät verbinden. Sein Port erscheint dann hier." />
    <Label Content="Bluetooth-Port" Target="PortBox" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <ComboBox x:Name="PortBox" HorizontalAlignment="Stretch"
                AutomationProperties.Name="Bluetooth-Port"
                ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                PlaceholderText="Kein Port gefunden" />
      <Button x:Name="RefreshPortsButton" Grid.Column="1" Content="Aktualisieren" Command="{Binding RefreshPortsCommand}" />
    </Grid>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto">
      <Label Content="Ländervorwahl" Target="CountryCodeBox" />
      <Label Grid.Column="1" Content="Amtsholung" Target="PrefixBox" />
      <TextBox x:Name="CountryCodeBox" Grid.Row="1" AutomationProperties.Name="Ländervorwahl" Text="{Binding HomeCountryCode}" />
      <TextBox x:Name="PrefixBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Amtsholung"
               Text="{Binding OutsideLinePrefix}" PlaceholderText="keine" />
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="SaveButton" Content="Speichern" Classes="accent" Command="{Binding SaveCommand}" />
      <Button x:Name="TestConnectionButton" Content="Verbindung testen" Command="{Binding TestConnectionCommand}" />
    </StackPanel>

    <TextBlock Classes="section" Text="Testanruf" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="TestNumberBox" AutomationProperties.Name="Rufnummer für den Testanruf"
               Text="{Binding TestNumber}" PlaceholderText="Rufnummer, z. B. das eigene Handy" />
      <Button x:Name="TestCallButton" Grid.Column="1" Content="Testanruf" Command="{Binding TestCallCommand}" />
    </Grid>

    <TextBlock Classes="section" Text="tel:-Links" />
    <TextBlock x:Name="IsDefaultText" Text="Freizeichen öffnet tel:-Links." IsVisible="{Binding IsDefaultHandler}" />
    <TextBlock x:Name="NotDefaultText" Classes="hint" Text="Ein anderes Programm öffnet tel:-Links." IsVisible="{Binding !IsDefaultHandler}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="MakeDefaultButton" Content="Als Standard festlegen" Command="{Binding MakeDefaultHandlerCommand}" />
      <Button x:Name="RefreshDefaultButton" Content="Prüfen" Command="{Binding RefreshDefaultHandlerCommand}" />
    </StackPanel>

    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    <TextBlock x:Name="StatusText" Classes="status" Classes.error="{Binding IsError}"
               Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
  </StackPanel>
</Window>
