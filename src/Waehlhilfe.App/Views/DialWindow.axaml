<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Waehlhilfe.AppLogic.ViewModels;assembly=Waehlhilfe.AppLogic"
        x:Class="Waehlhilfe.App.Views.DialWindow"
        x:ClassModifier="internal"
        x:DataType="vm:DialViewModel"
        Title="Wählhilfe – Anrufen"
        Width="420" SizeToContent="Height"
        CanResize="False" Topmost="True"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock.status.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="Anrufen über das Telefon" Opacity="0.7" />
    <SelectableTextBlock x:Name="NumberText"
                         Text="{Binding Number}"
                         FontSize="30" FontWeight="SemiBold"
                         IsVisible="{Binding Number, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock x:Name="StatusText"
               Classes="status" Classes.error="{Binding IsError}"
               Text="{Binding Status}" TextWrapping="Wrap" />
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Content="Abbrechen" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button x:Name="DialButton" Content="Wählen" IsDefault="True" Classes="accent" Command="{Binding DialCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
