<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Waehlhilfe.App.Views.SettingsWindow"
        x:ClassModifier="internal"
        Title="Wählhilfe"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="Wählhilfe" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Text="Wählt tel:-Links über ein Gigaset-Telefon per Bluetooth." TextWrapping="Wrap" />
  </StackPanel>
</Window>
