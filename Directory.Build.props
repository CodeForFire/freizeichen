<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- TreatWarningsAsErrors is Roslyn-only. Avalonia's XAML compiler logs through MSBuild, so
         AVLN5001 ("member is obsolete") would only print a warning, and only on a full rebuild.
         Escalated on its own: the whole AVLN class also covers warnings that are not deprecations. -->
    <MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);AVLN5001</MSBuildWarningsAsErrors>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>10.0</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required so IDE0005 (unused usings) runs during build; CS1591 is the XML-doc noise it
         would otherwise bring along. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- CI restores in locked mode, so a restore that resolves anything other than the committed
         graph fails instead of building. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
